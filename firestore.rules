rules_version = '2';

// (#359) Firestore rules for project home-strength. The owner pastes this file in the Firebase
// console (Firestore > Rules) after replacing ADMIN_EMAIL with the admin Google account. The real
// address is never committed. The app never checks the email; these rules are the lock.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL'
        && request.auth.token.email_verified == true;
    }

    function str(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // (#255) Feedback notes: anyone may create one with exactly these fields and sizes. Only the
    // admin may read them, and the admin may change only the `done` flag. Nobody may delete.
    match /feedback/{noteId} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'name', 'appVersion', 'screen', 'device', 'workoutCount', 'testerId'])
        && request.resource.data.keys().hasAll(['message', 'appVersion', 'screen', 'device', 'workoutCount', 'testerId'])
        && str(request.resource.data.message, 1, 2000)
        && (!('name' in request.resource.data) || str(request.resource.data.name, 1, 80))
        && str(request.resource.data.appVersion, 1, 40)
        && request.resource.data.screen in ['settings', 'recap']
        && request.resource.data.device in ['iphone', 'android', 'other']
        && request.resource.data.workoutCount is int && request.resource.data.workoutCount >= 0
        && str(request.resource.data.testerId, 1, 64);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is bool;
    }

    // (#359) Usage events: create-only, exactly these six fields, small values. Only the admin reads.
    match /events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['testerId', 'event', 'dayType', 'appVersion', 'date', 'createdAt'])
        && request.resource.data.keys().hasAll(['testerId', 'event', 'dayType', 'appVersion', 'date', 'createdAt'])
        && str(request.resource.data.testerId, 8, 64)
        && request.resource.data.event in ['workout-started', 'workout-finished', 'workout-cut-short', 'switch', 'plan-today', 'replace', 'supersets-on', 'supersets-off', 'backup', 'feedback']
        && (request.resource.data.dayType == null || request.resource.data.dayType in ['push', 'pull', 'legs', 'upper', 'lower', 'full-body', 'picked'])
        && str(request.resource.data.appVersion, 1, 40)
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin();
    }
  }
}
