rules_version = '2';

// (#359) Firestore rules for project home-strength. The owner pastes this file in the Firebase
// console (Firestore > Rules) after replacing ADMIN_EMAIL with the admin Google account. The real
// address is never committed. The app never checks the email; these rules are the lock.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL'
        && request.auth.token.email_verified == true;
    }

    function str(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // (#255) Feedback notes: anyone may create one with exactly these fields and sizes. Only the
    // admin may read them, and the admin may change only the `done` flag. Nobody may delete.
    match /feedback/{noteId} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'name', 'appVersion', 'screen', 'device', 'workoutCount', 'testerId'])
        && request.resource.data.keys().hasAll(['message', 'appVersion', 'screen', 'device', 'workoutCount', 'testerId'])
        && str(request.resource.data.message, 1, 2000)
        && (!('name' in request.resource.data) || str(request.resource.data.name, 1, 80))
        && str(request.resource.data.appVersion, 1, 40)
        && request.resource.data.screen in ['settings', 'recap']
        && request.resource.data.device in ['iphone', 'android', 'other']
        && request.resource.data.workoutCount is int && request.resource.data.workoutCount >= 0
        && str(request.resource.data.testerId, 1, 64);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is bool;
    }

    // (#359) Usage events: create-only, exactly these six fields, small values. Only the admin reads.
    match /events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['testerId', 'event', 'dayType', 'appVersion', 'date', 'createdAt'])
        && request.resource.data.keys().hasAll(['testerId', 'event', 'dayType', 'appVersion', 'date', 'createdAt'])
        && str(request.resource.data.testerId, 8, 64)
        && request.resource.data.event in ['workout-started', 'workout-finished', 'workout-cut-short', 'switch', 'plan-today', 'replace', 'supersets-on', 'supersets-off', 'backup', 'feedback']
        && (request.resource.data.dayType == null || request.resource.data.dayType in ['push', 'pull', 'legs', 'upper', 'lower', 'full-body', 'picked'])
        && str(request.resource.data.appVersion, 1, 40)
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin();
    }

    // (#360) Exercises and equipment added from /admin. Anyone may read a published row (the app's query
    // asks for exactly those); drafts and unpublished rows only the admin. Only the admin writes, with
    // exactly these fields and the app's own vocabularies, and a row with a photo or video can't be saved
    // without its source, licence and credit (#254). The id is `add-` words, so it can't be a built-in id.
    // Nobody deletes: an unpublished row stays, so phones keep it for history.
    function catalogRow(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'kind', 'status', 'name', 'muscles', 'pattern', 'item', 'instructions', 'cues', 'photo', 'video', 'source', 'licence', 'credit', 'family', 'group', 'updatedAt'])
        && d.keys().hasAll(['id', 'kind', 'status', 'name', 'updatedAt'])
        && d.id == id && id.size() <= 48 && id.matches('add-[a-z0-9]+(-[a-z0-9]+)*')
        && d.status in ['draft', 'published', 'unpublished']
        && str(d.name, 2, 60)
        && d.updatedAt is timestamp
        && ((d.kind == 'equipment'
            && d.keys().hasOnly(['id', 'kind', 'status', 'name', 'family', 'group', 'updatedAt'])
            && d.family in ['Barbell', 'Dumbbell', 'Machine', 'Cable', 'Kettlebell']
            && d.group in ['Legs machines', 'Upper machines', 'Cables', 'Free weights'])
          || (d.kind == 'exercise'
            && d.keys().hasAll(['muscles', 'pattern', 'item', 'instructions', 'cues'])
            && !d.keys().hasAny(['family', 'group'])
            && d.muscles is list && d.muscles.size() >= 1 && d.muscles.size() <= 4
            && d.muscles.hasOnly(['Chest', 'Back', 'Shoulders', 'Biceps', 'Triceps', 'Quads', 'Hamstrings', 'Glutes', 'Calves', 'Core'])
            && d.pattern in ['horizontal_push', 'vertical_push', 'horizontal_pull', 'vertical_pull', 'squat', 'lunge', 'hinge', 'hip_extension', 'knee_extension', 'knee_flexion', 'calf_raise', 'elbow_flexion', 'elbow_extension', 'shoulder_abduction', 'shoulder_horizontal_abduction', 'core_flexion', 'core_stability']
            && str(d.item, 1, 48)
            && str(d.instructions, 1, 600)
            && d.cues is list && d.cues.size() <= 5
            && (!('photo' in d) || (d.photo is string && d.photo.matches('catalog/' + id + '/photo-[0-9]{1,15}[.](jpg|png|webp)')))
            && (!('video' in d) || (d.video is string && d.video.matches('catalog/' + id + '/video-[0-9]{1,15}[.]mp4')))
            && (!d.keys().hasAny(['photo', 'video', 'source', 'licence', 'credit'])
              || (str(d.source, 1, 300) && str(d.credit, 1, 120) && d.licence in ['own-work', 'cc0', 'cc-by', 'public-domain']))));
    }

    match /catalog/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && catalogRow(id);
    }
  }
}
